{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "jsx-a11y",
    "import"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "import/no-unassigned-import": [
      "error",
      {
        "allow": [
          "**/*.css"
        ]
      }
    ]
  },
  "env": {
    "browser": true,
    "es2024": true
  },
  "ignorePatterns": [
    "build/**",
    "car-wash-app/**",
    "node_modules/**",
    "playwright-report/**",
    "test-results/**"
  ]
}
